{
  "name": "Fahrt",
  "type": "object",
  "properties": {
    "datum": {
      "type": "string",
      "format": "date",
      "title": "Datum"
    },
    "startort": {
      "type": "string",
      "title": "Startort"
    },
    "zielort": {
      "type": "string",
      "title": "Zielort"
    },
    "zweck": {
      "type": "string",
      "title": "Zweck"
    },
    "kilometer": {
      "type": "number",
      "title": "Kilometer"
    },
    "projekt_id": {
      "type": "string",
      "reference": "Projekt",
      "title": "Projekt"
    },
    "uhrzeit_start": {
      "type": "string",
      "title": "Uhrzeit Start"
    },
    "uhrzeit_ende": {
      "type": "string",
      "title": "Uhrzeit Ende"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "offen",
        "abgeschlossen"
      ],
      "default": "abgeschlossen"
    },
    "gps_start": {
      "type": "string",
      "title": "GPS Start"
    },
    "gps_end": {
      "type": "string",
      "title": "GPS Ende"
    }
  },
  "required": [
    "datum",
    "startort",
    "zielort",
    "kilometer"
  ],
  "rls": {
    "read": {},
    "update": {},
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by_id": "anonymous"
        }
      ]
    }
  }
}