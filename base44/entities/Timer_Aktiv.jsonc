{
  "name": "Timer_Aktiv",
  "type": "object",
  "properties": {
    "projekt_id": {
      "type": "string",
      "reference": "Projekt",
      "title": "Projekt"
    },
    "start_zeit": {
      "type": "string",
      "format": "date-time",
      "title": "Startzeit"
    },
    "beschreibung": {
      "type": "string",
      "title": "Beschreibung"
    }
  },
  "required": [
    "projekt_id",
    "start_zeit"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by_id": "anonymous"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by_id": "anonymous"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by_id": "anonymous"
        }
      ]
    }
  }
}