{
  "name": "Aenderungswunsch",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string",
      "title": "Titel"
    },
    "beschreibung": {
      "type": "string",
      "title": "Beschreibung"
    },
    "bereich": {
      "type": "string",
      "title": "Bereich",
      "enum": [
        "Zeiterfassung",
        "Fahrtenbuch",
        "Projekte",
        "Kunden",
        "Finanzen",
        "Sonstiges"
      ],
      "default": "Sonstiges"
    },
    "prioritaet": {
      "type": "string",
      "title": "Priorit\u00e4t",
      "enum": [
        "Niedrig",
        "Normal",
        "Hoch"
      ],
      "default": "Normal"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Neu",
        "Gemeldet",
        "Erledigt"
      ],
      "default": "Neu"
    },
    "eingereicht_von": {
      "type": "string",
      "title": "Eingereicht von"
    },
    "quelle": {
      "type": "string",
      "title": "Quelle"
    },
    "datum": {
      "type": "string",
      "format": "date",
      "title": "Datum"
    }
  },
  "required": [
    "titel"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by_id": "anonymous"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by_id": "anonymous"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}