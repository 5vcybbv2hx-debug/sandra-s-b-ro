{
  "name": "Projekt",
  "type": "object",
  "properties": {
    "projekt_name": {
      "type": "string",
      "title": "Projektname"
    },
    "firma_id": {
      "type": "string",
      "reference": "Firma",
      "title": "Firma"
    },
    "haupt_ansprechpartner_id": {
      "type": "string",
      "reference": "Ansprechpartner",
      "title": "Hauptansprechpartner"
    },
    "weitere_ansprechpartner_ids": {
      "type": "array",
      "title": "Weitere Ansprechpartner",
      "items": {
        "type": "string"
      }
    },
    "beschreibung": {
      "type": "string",
      "title": "Beschreibung"
    },
    "projektart": {
      "type": "string",
      "title": "Projektart",
      "enum": [
        "Wohnbau",
        "Gewerbebau",
        "Öffentliches Bauvorhaben",
        "Umbau/Sanierung",
        "Sonstiges",
        "Intern"
      ],
      "default": "Sonstiges"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Anfrage",
        "Aktiv",
        "Wartend",
        "Abgeschlossen",
        "Abgebrochen",
        "Archiviert"
      ],
      "default": "Anfrage"
    },
    "startdatum": {
      "type": "string",
      "format": "date",
      "title": "Startdatum"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "title": "Deadline"
    },
    "stundensatz": {
      "type": "number",
      "title": "Stundensatz",
      "default": 0
    },
    "abrechnungsart": {
      "type": "string",
      "title": "Abrechnungsart",
      "enum": [
        "Stündlich",
        "Pauschal"
      ],
      "default": "Stündlich"
    },
    "pauschalbetrag": {
      "type": "number",
      "title": "Pauschalbetrag",
      "default": 0
    },
    "geschaetzte_stunden_gesamt": {
      "type": "number",
      "title": "Geschätzte Stunden Gesamt",
      "default": 0
    },
    "abgerechnete_stunden": {
      "type": "number",
      "title": "Abgerechnete Stunden",
      "default": 0
    },
    "ist_abgerechnet": {
      "type": "boolean",
      "title": "Abgerechnet",
      "default": false
    },
    "notizen": {
      "type": "string",
      "title": "Notizen"
    },
    "aktuelle_phase": {
      "type": "string",
      "title": "Aktuelle Phase",
      "enum": [
        "Entwurf",
        "Baugesuch",
        "Werkplanung"
      ],
      "default": "Entwurf"
    },
    "access_scope": {
      "type": "string",
      "title": "Access Scope",
      "enum": [
        "private",
        "team",
        "org"
      ],
      "default": "team"
    },
    "is_internal": {
      "type": "boolean",
      "title": "Internes Projekt",
      "default": false
    },
    "pinned": {
      "type": "boolean",
      "title": "Angeheftet",
      "default": false
    },
    "pinned_order": {
      "type": "number",
      "title": "Anheft-Reihenfolge",
      "default": 0
    }
  },
  "required": [
    "projekt_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by_id": "anonymous"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by_id": "anonymous"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by_id": "anonymous"
        }
      ]
    }
  }
}
